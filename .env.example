# Copy this file to .env and fill in your keys.
# Without OPENAI_API_KEY, Zextrex still answers — using the offline reply set in assistant.py.
# Without SMTP_EMAIL / SMTP_APP_PASSWORD, the contact form shows a clear
# "not configured yet" message instead of sending — see emailer.py for setup.

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Gmail account the contact form sends FROM (needs an App Password — see emailer.py)
SMTP_EMAIL=your-sending-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password

# Who receives contact-form messages
CONTACT_TO_EMAIL=zextrexsupport@gmail.com
